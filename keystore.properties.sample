# BECETTI TOOLS — نموذج إعدادات توقيع النسخة النهائية (Release)
# انشئ من هذا النموذج ملفاً בשם keystore.properties في جذر المشروع، وأمّن مدخلات كلمة المرور.
# هذا الملف مستبعد من git (.gitignore) ولا يُرفق إلى المستودع.

# إنشاء مخزن التوقيع (يُنفّذ مرة واحدة على الجهاز الذي يحوي Java keytool):
#   keytool -genkeypair -v \
#     -keystore release-keystore.jks \
#     -alias becetti \
#     -keyalg RSA -keysize 2048 \
#     -validity 10000 \
#     -dname "CN=BECETTI TOOLS, OU=BECETTI, O=BECETTI, L=Chlef, S=Chlef, C=DZ"

storeFile=release-keystore.jks
storePassword=<<ضع هنا كلمة مرور مخزن المفتاح>>
keyAlias=becetti
keyPassword=<<ضع هنا كلمة مرور المفتاح>>

# بدلاً من الملف يمكن تمرير المتغيرات البيئية أثناء البناء:
#   export BECETTI_STORE_FILE=release-keystore.jks
#   export BECETTI_STORE_PASSWORD=...
#   export BECETTI_KEY_ALIAS=becetti
#   export BECETTI_KEY_PASSWORD=...
